{
  "hooks": {
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 .agentflow/bin/agentflow.py hook prompt", "timeout": 20, "onFailure": "block"}]}
    ],
    "PreToolUse": [
      {"matcher": ".*", "hooks": [{"type": "command", "command": "python3 .agentflow/bin/agentflow.py hook pretool", "timeout": 15, "onFailure": "block"}]}
    ],
    "PostToolUse": [
      {"matcher": "Write|Edit|MultiEdit", "hooks": [{"type": "command", "command": "python3 .agentflow/bin/agentflow.py hook posttool", "timeout": 10}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 .agentflow/bin/agentflow.py hook end", "timeout": 5}]}
    ]
  }
}
