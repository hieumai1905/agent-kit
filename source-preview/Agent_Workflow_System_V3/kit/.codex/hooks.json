{
  "hooks": {
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 .agentflow/bin/agentflow.py hook prompt", "timeout": 20}]}
    ],
    "PreToolUse": [
      {"hooks": [{"type": "command", "command": "python3 .agentflow/bin/agentflow.py hook pretool", "timeout": 15}]}
    ],
    "PostToolUse": [
      {"matcher": "apply_patch|Edit|Write|MultiEdit", "hooks": [{"type": "command", "command": "python3 .agentflow/bin/agentflow.py hook posttool", "timeout": 10}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 .agentflow/bin/agentflow.py hook end", "timeout": 3}]}
    ]
  }
}
